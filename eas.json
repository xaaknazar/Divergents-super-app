{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_STORYBOOK_ENABLED": "false"
      }
    },
    "production-reading": {
      "extends": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_STORYBOOK_ENABLED": "false",
        "EXPO_PUBLIC_READING_CHALLENGES": "true",
        "READING_FOCUS_PILOT": "true",
        "EXPO_NO_CAPABILITY_SYNC": "1"
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6796377452"
      }
    }
  }
}
