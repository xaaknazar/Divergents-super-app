# Base exclusions from .gitignore. Native projects are regenerated by EAS.
node_modules/
.expo/
dist/
web-build/
*.log
.DS_Store
*.orig.*
.env
/ios/
/android/
.install*
*.ipa
*.apk
*.aab

# Local design references and signing/environment material are not build inputs.
.impeccable/
/divergents-design-handoff-2026-10-20/
/.claude/
/native-tests/reading-focus/generated/
/native-tests/reading-focus/*.xcodeproj/
.env.*
credentials.json
*.p8
*.p12
*.mobileprovision
